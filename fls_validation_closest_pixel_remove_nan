            df = pd.read_excel(file_path)
            
            # Standardiser les noms de colonnes
            df.columns = [col.lower().strip() for col in df.columns]
            
            # Vérifier les colonnes requises
            required_cols = ['jour', 'hour']
            if not all(col in df.columns for col in required_cols):
                print(f"Colonnes manquantes dans {file_path.name}. Colonnes disponibles: {df.columns.tolist()}")
                return None
            
            # Trouver la colonne FLS (peut s'appeler 'fls' ou autre)
            fls_col = None
            for col in df.columns:
                if 'fls' in col.lower():
                    fls_col = col
                    break
            
            if fls_col is None:
                print(f"Aucune colonne FLS trouvée dans {file_path.name}")
                return None
            
            # Convertir la date et l'heure
            df['datetime'] = pd.to_datetime(df['jour'].astype(str) + 
                                          df['hour'].astype(str).str.zfill(2), 
                                          format='%Y%m%d%H')
            df['date'] = df['datetime'].dt.date
            df['hour'] = df['datetime'].dt.hour
            df['month'] = df['datetime'].dt.month
            df['year'] = df['datetime'].dt.year

            # CORRECTION: Nettoyage approfondi des données station
            print(f"  Type de données station avant conversion: {df[fls_col].dtype}")
            print(f"  Exemple de valeurs station avant conversion: {df[fls_col].head(10).tolist()}")
            
            # Convertir en string d'abord pour nettoyer
            df[fls_col] = df[fls_col].astype(str)
            
            # Nettoyer les chaînes de caractères
            df[fls_col] = df[fls_col].str.strip().str.replace(' ', '').str.replace(',', '.').str.replace('"', '').str.replace("'", "")
            
            # NOUVEAU: Remplacer les valeurs -9999 par 0 (valeurs manquantes spécifiques)
            df[fls_col] = df[fls_col].replace({
                'nan': '0', 'NaN': '0', 'None': '0', 'none': '0',
                'True': '1', 'False': '0', 'true': '1', 'false': '0',
                '-9999': '0', '9999': '0', '-9999.0': '0', '9999.0': '0'  # Valeurs d'erreur courantes
            })
            
            # Identifier les valeurs non numériques
            numeric_mask = df[fls_col].str.match(r'^-?\d*\.?\d+$', na=False)
            non_numeric_count = (~numeric_mask).sum()
            
            if non_numeric_count > 0:
                print(f"  ATTENTION: {non_numeric_count} valeurs non-numériques trouvées dans les données station:")
                problematic_values = df[~numeric_mask][fls_col].unique()
                print(f"  Valeurs problématiques: {problematic_values}")
                
                # Essayer de convertir les valeurs problématiques
                for val in problematic_values:
                    try:
                        # Essayer de convertir en float
                        float_val = float(val)
                        df.loc[df[fls_col] == val, fls_col] = str(float_val)
                        print(f"    Converti '{val}' en '{float_val}'")
                    except:
                        # Si échec, remplacer par 0
                        df.loc[df[fls_col] == val, fls_col] = '0'
                        print(f"    Remplacé '{val}' par '0'")
            
            # Convertir en numérique
            df['fls_stat'] = pd.to_numeric(df[fls_col], errors='coerce')
            
            # NOUVEAU: Supprimer les lignes avec des valeurs NaN dans fls_stat
            initial_count = len(df)
            df = df.dropna(subset=['fls_stat'])
            final_count = len(df)
