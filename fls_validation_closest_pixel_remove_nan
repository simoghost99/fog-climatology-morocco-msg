class FogHeatmapGenerator:
    """Classe pour générer les heatmaps des tables de contingence"""

    def __init__(self):
        self.station_data_path = STATION_DATA_PATH
        self.heatmap_path = HEATMAP_PATH

    def create_contingency_table(self, df, threshold=0.5):
        """Créer la table de contingence à partir des données"""
        # Binariser les données avec le seuil
        df_binary = df.copy()
        df_binary['fls_satellite_bin'] = (df_binary['fls_satellite'] >= threshold).astype(int)
        df_binary['fls_station_bin'] = (df_binary['fls_station'] >= threshold).astype(int)

        # Calculer la table de contingence
        contingency_table = pd.crosstab(
            df_binary['fls_satellite_bin'],
            df_binary['fls_station_bin'],
            rownames=['Satellite'],
            colnames=['Station'],
            margins=True
        )

        # Renommer les index et colonnes pour plus de clarté
        contingency_table.index = ['Non (0)', 'Oui (1)', 'Total']
        contingency_table.columns = ['Non (0)', 'Oui (1)', 'Total']

        return contingency_table

    def calculate_contingency_values(self, df, threshold=0.5):
        """Calculer les valeurs de la table de contingence"""
        # Binariser les données
        df_binary = df.copy()
        df_binary['fls_satellite_bin'] = (df_binary['fls_satellite'] >= threshold).astype(int)
        df_binary['fls_station_bin'] = (df_binary['fls_station'] >= threshold).astype(int)

        # Calculer les quatre cas
        hits = ((df_binary['fls_satellite_bin'] == 1) & (df_binary['fls_station_bin'] == 1)).sum()
        false_alarms = ((df_binary['fls_satellite_bin'] == 1) & (df_binary['fls_station_bin'] == 0)).sum()
        misses = ((df_binary['fls_satellite_bin'] == 0) & (df_binary['fls_station_bin'] == 1)).sum()
        correct_negatives = ((df_binary['fls_satellite_bin'] == 0) & (df_binary['fls_station_bin'] == 0)).sum()

        total = len(df_binary)

        return hits, false_alarms, misses, correct_negatives, total

    def plot_contingency_heatmap(self, station_name, fog_type):
        """Générer une heatmap pour une station spécifique"""
        filename = f"{self.station_data_path}/{station_name}_{fog_type}_comparison.csv"

        if not os.path.exists(filename):
            print(f"  Fichier non trouvé: {filename}")
            return

        try:
            # Charger les données
            df = pd.read_csv(filename)
            df['datetime'] = pd.to_datetime(df['datetime'])

            # Calculer les valeurs de contingence
            hits, false_alarms, misses, correct_negatives, total = self.calculate_contingency_values(df)

            # Créer la matrice pour la heatmap
            contingency_matrix = np.array([
                [correct_negatives, misses],
                [false_alarms, hits]
            ])

            # Créer les labels pour la heatmap
            labels = np.array([
                [f"Correct Negative\n{correct_negatives}\n({correct_negatives/total*100:.1f}%)",
                 f"Miss\n{misses}\n({misses/total*100:.1f}%)"],
                [f"False Alarm\n{false_alarms}\n({false_alarms/total*100:.1f}%)",
                 f"Hit\n{hits}\n({hits/total*100:.1f}%)"]
            ])

            # Créer la figure
            fig, ax = plt.subplots(figsize=(10, 8))

            # Créer la heatmap
            sns.heatmap(contingency_matrix, annot=labels, fmt='',
                       cmap='RdYlBu', cbar=True, square=True,
                       linewidths=2, linecolor='white',
                       annot_kws={'size': 12, 'weight': 'bold'},
                       ax=ax)

            # Configurer les axes
            ax.set_xticklabels(['Station = Non', 'Station = Oui'], rotation=0, fontsize=12)
            ax.set_yticklabels(['Satellite = Non', 'Satellite = Oui'], rotation=90, fontsize=12)

            # Titre et labels
            title = f'Table de Contingence - {station_name} ({fog_type.upper()})\n'
            title += f'Total observations: {total} | Seuil: 0.5 | Méthode: 9 pixels'
            ax.set_title(title, fontsize=14, fontweight='bold', pad=20)

            # Ajouter les descriptions
            descriptions = [
                "Hit: Prévu = Oui, Observé = Oui (Prévu brouillard, brouillard observé)",
                "False Alarm: Prévu = Oui, Observé = Non (Prévu brouillard, pas de brouillard)",
                "Miss: Prévu = Non, Observé = Oui (Pas prévu brouillard, mais brouillard observé)",
                "Correct Negative: Prévu = Non, Observé = Non (Pas prévu brouillard, pas de brouillard)"
            ]

            # Ajouter la légende
            for i, desc in enumerate(descriptions):
                ax.text(2.5, 0.3 + i*0.15, desc, transform=ax.transAxes,
                       fontsize=10, verticalalignment='top')

            # Calculer et afficher les scores
            pod = hits / (hits + misses) if (hits + misses) > 0 else 0
            far = false_alarms / (hits + false_alarms) if (hits + false_alarms) > 0 else 0
            accuracy = (hits + correct_negatives) / total if total > 0 else 0

            stats_text = f"Scores:\nPOD: {pod:.3f}\nFAR: {far:.3f}\nAccuracy: {accuracy:.3f}"
            ax.text(2.5, 0.9, stats_text, transform=ax.transAxes,
                   fontsize=11, bbox=dict(boxstyle="round,pad=0.3", facecolor="lightgray"))

            plt.tight_layout()

            # Sauvegarder la figure
            output_filename = f"{self.heatmap_path}/contingency_heatmap_{station_name}_{fog_type}.png"
            plt.savefig(output_filename, dpi=300, bbox_inches='tight')
            plt.close()

            print(f"  ✓ Heatmap générée: {output_filename}")

        except Exception as e:
            print(f"  ✗ Erreur génération heatmap pour {station_name}_{fog_type}: {e}")

    def generate_all_heatmaps(self):
        """Générer les heatmaps pour toutes les stations"""
        print("\n=== GÉNÉRATION DES HEATMAPS ===")

