            'HITS': 0, 'FALSE_ALARMS': 0, 'MISSES': 0, 'CORRECT_NEGATIVES': 0
        }
    
    def calculate_verification_scores(self, observed, forecast):
        """Calculer les scores de vérification avec gestion robuste des données"""
        # S'assurer que les données sont numériques
        observed = pd.to_numeric(observed, errors='coerce')
        forecast = pd.to_numeric(forecast, errors='coerce')
        
        # Supprimer les NaN
        mask = ~(np.isnan(observed) | np.isnan(forecast))
        observed = observed[mask]
        forecast = forecast[mask]
        
        if len(observed) == 0:
            print("  Aucune donnée valide après nettoyage des NaN")
            return self._create_empty_scores()
        
        # Conversion en booléen pour FLS présent/absent
        obs_bool = (observed > 0).astype(int)
        fc_bool = (forecast > 0).astype(int)
        
        print(f"  Observations valides: {len(observed)}")
        print(f"  FLS observé: {obs_bool.sum()} / {len(obs_bool)}")
        print(f"  FLS prévu: {fc_bool.sum()} / {len(fc_bool)}")
        
        # Table de contingence
        a = ((fc_bool == 1) & (obs_bool == 1)).sum()  # Hits
        b = ((fc_bool == 1) & (obs_bool == 0)).sum()  # False alarms
        c = ((fc_bool == 0) & (obs_bool == 1)).sum()  # Misses
        d = ((fc_bool == 0) & (obs_bool == 0)).sum()  # Correct negatives
        
        print(f"  Table de contingence: Hits={a}, False Alarms={b}, Misses={c}, Correct Negatives={d}")
        
        # Calcul des scores
        scores = {}
        
        # POD (Probability Of Detection)
        if (a + c) > 0:
            scores['POD'] = a / (a + c)
        else:
            scores['POD'] = np.nan
            
        # FAR (False Alarm Ratio)
        if (a + b) > 0:
            scores['FAR'] = b / (a + b)
        else:
            scores['FAR'] = np.nan
            
        # FBIAS (Frequency Bias)
        if (a + c) > 0:
            scores['FBIAS'] = (a + b) / (a + c)
        else:
            scores['FBIAS'] = np.nan
            
        # POFD (Probability Of False Detection)
        if (b + d) > 0:
            scores['POFD'] = b / (b + d)
        else:
            scores['POFD'] = np.nan
            
        # TS (Threat Score)
        if (a + b + c) > 0:
            scores['TS'] = a / (a + b + c)
        else:
            scores['TS'] = np.nan
            
        # HSS (Heidke Skill Score)
        denominator = ((a+c)*(c+d) + (a+b)*(b+d))
        if denominator > 0:
            scores['HSS'] = 2*(a*d - b*c) / denominator
        else:
            scores['HSS'] = np.nan
            
        # Accuracy
        if (a + b + c + d) > 0:
            scores['ACCURACY'] = (a + d) / (a + b + c + d)
        else:
            scores['ACCURACY'] = np.nan
            
        # Base rates
        total = a + b + c + d
        if total > 0:
            scores['OBS_RATE'] = (a + c) / total
            scores['FC_RATE'] = (a + b) / total
        else:
            scores['OBS_RATE'] = np.nan
            scores['FC_RATE'] = np.nan
        
        # Comptes
        scores['HITS'] = a
        scores['FALSE_ALARMS'] = b
        scores['MISSES'] = c
        scores['CORRECT_NEGATIVES'] = d
        
        print(f"  Scores calculés: POD={scores.get('POD', 'NaN'):.3f}, FAR={scores.get('FAR', 'NaN'):.3f}, FBIAS={scores.get('FBIAS', 'NaN'):.3f}")
        
        return scores
    
