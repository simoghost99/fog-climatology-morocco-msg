    print("=== DÉBUT DE L'ANALYSE FLS (9 PIXELS) ===")

    # Créer le processeur
    processor = FogDataProcessor()

    # Lister les fichiers
    satellite_files = list(Path(SATELLITE_PATH).glob('*fls_RGB.csv'))
    station_files = list(Path(STATION_PATH).glob('*fls_600*.xlsx'))

    print(f"Fichiers satellite trouvés: {len(satellite_files)}")
    print(f"Fichiers station trouvés: {len(station_files)}")

    # AFFICHER LES FICHIERS TROUVÉS (DEBUG)
    print("\n=== FICHIERS SATELLITE TROUVÉS ===")
    for sat_file in satellite_files:
        sat_name = processor.parse_satellite_station_name(sat_file.name)
        print(f"  {sat_file.name} -> '{sat_name}'")

    print("\n=== FICHIERS STATION TROUVÉS ===")
    for stat_file in station_files:
        station_name, month, fog_type = processor.parse_station_filename(stat_file.name)
        print(f"  {stat_file.name} -> '{station_name}', mois {month}, type {fog_type}")

    all_results = []

    # Traiter seulement les stations qui ont des données dans donnesfls
    stations_to_process = []

    # Identifier les stations disponibles dans donnesfls
    for station_file in station_files:
        station_name, month, fog_type = processor.parse_station_filename(station_file.name)
        if station_name and station_name not in stations_to_process:
            stations_to_process.append(station_name)

    print(f"\nStations à traiter ({len(stations_to_process)}): {stations_to_process}")

    # Pour chaque station dans donnesfls, trouver le fichier satellite correspondant
    for station_donnesfls in stations_to_process:
        print(f"\n=== Traitement de la station: {station_donnesfls} ===")

        # Trouver le nom correspondant dans flsparrgb
        satellite_station_name = None
        for sat_name, donnesfls_name in processor.station_mapping.items():
            if donnesfls_name == station_donnesfls:
                satellite_station_name = sat_name
                break

        if not satellite_station_name:
            print(f"  Aucune correspondance trouvée dans les fichiers satellite pour {station_donnesfls}")
            continue

        # Trouver le fichier satellite
        satellite_file = None
        for sat_file in satellite_files:
            sat_station_from_file = processor.parse_satellite_station_name(sat_file.name)
            if sat_station_from_file == satellite_station_name:
                satellite_file = sat_file
                break

        if not satellite_file:
            print(f"  Fichier satellite non trouvé pour {satellite_station_name}")
            continue

        print(f"  Fichier satellite trouvé: {satellite_file.name}")

        # Charger les données satellite une fois pour toute la station
        satellite_df = processor.load_satellite_data(satellite_file)
        if satellite_df is None:
            continue

        # Trouver tous les fichiers station pour cette station
        station_files_for_station = [
            f for f in station_files
            if station_donnesfls in f.name
        ]

        print(f"  Fichiers station trouvés: {len(station_files_for_station)}")

        # Traiter pour chaque type de contrainte
        for fog_type in ['cf', 'hc']:
            results = processor.process_station_month(
                station_donnesfls, satellite_df, station_files_for_station, fog_type
            )

            if results is not None and not results.empty:
                all_results.append(results)
                print(f"  ✓ Scores calculés pour {station_donnesfls} ({fog_type})")
            else:
                print(f"  ✗ Échec du calcul des scores pour {station_donnesfls} ({fog_type})")

    # Combiner tous les résultats
    if all_results:
        final_results = pd.concat(all_results, ignore_index=True)

        # Sauvegarder les résultats complets
        final_results.to_csv(f'{OUTPUT_PATH}/scores_fls_complet.csv', index=False)

        print(f"\n=== ANALYSE TERMINÉE AVEC SUCCÈS ===")
        print(f"Stations traitées: {final_results['station'].nunique()}")
        print(f"Types de brouillard analysés: {final_results['fog_type'].unique().tolist()}")
        print(f"Nombre total de scores calculés: {len(final_results)}")
        print(f"Fichier de résultats: {OUTPUT_PATH}/scores_fls_complet.csv")

        return final_results
    else:
        print("\n=== AUCUN RÉSULTAT GÉNÉRÉ ===")
        return None

# Fonction pour exécuter l'analyse complète
