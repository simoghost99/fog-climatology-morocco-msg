    def _create_empty_scores(self):
        """Créer un dictionnaire de scores vide"""
        return {
            'POD': np.nan, 'FAR': np.nan, 'FBIAS': np.nan, 'POFD': np.nan,
            'TS': np.nan, 'HSS': np.nan, 'ACCURACY': np.nan,
