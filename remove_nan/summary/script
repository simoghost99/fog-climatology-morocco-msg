import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
df = pd.read_csv('remove_nan/results-9pixel/tableau_recap_annuel.csv')

# Create a combined station-forecast type label
df['Station_Type'] = df['station'] + '_' + df['fog_type']

# Select the main verification metrics for the heatmap
metrics = ['POD', 'FAR', 'TS', 'HSS', 'ACCURACY', 'FBIAS']
heatmap_data = df[['Station_Type'] + metrics].set_index('Station_Type')

# Create the heatmap
plt.figure(figsize=(12, 8))
sns.heatmap(heatmap_data, annot=True, cmap='RdYlBu_r', center=0.5, 
            fmt='.3f', linewidths=0.5, cbar_kws={'label': 'Metric Value'})
plt.title('Verification Metrics Heatmap by Station and Forecast Type', fontsize=14, pad=20)
plt.xticks(rotation=45)
plt.yticks(rotation=0)
plt.tight_layout()
plt.show()

# Create a separate heatmap for contingency table elements
contingency_metrics = ['HITS', 'FALSE_ALARMS', 'MISSES']
contingency_data = df[['Station_Type'] + contingency_metrics].set_index('Station_Type')

plt.figure(figsize=(10, 6))
sns.heatmap(contingency_data, annot=True, cmap='YlOrRd', fmt='d', 
            linewidths=0.5, cbar_kws={'label': 'Count'})
plt.title('Contingency Table Elements Heatmap', fontsize=14, pad=20)
plt.xticks(rotation=45)
plt.yticks(rotation=0)
plt.tight_layout()
plt.show()

# Calculate summary statistics by forecast type
print("Summary Statistics by Forecast Type:")
summary = df.groupby('fog_type')[metrics].mean()
print(summary)
