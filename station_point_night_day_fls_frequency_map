# Define output directories for all 4 combinations
output_dirs = {
    'jour_cf': "output_maps_2024_jour_cf",
    'jour_hc': "output_maps_2024_jour_hc", 
    'nuit_cf': "output_maps_2024_nuit_cf",
    'nuit_hc': "output_maps_2024_nuit_hc"
}

for dir_name in output_dirs.values():
    os.makedirs(dir_name, exist_ok=True)

# Define custom colormap
colors = [
    (0.0,  'black'),
    (0.05, 'midnightblue'),
    (0.15, 'blue'),
    (0.30, 'lightskyblue'),
    (0.45, 'lemonchiffon'),
    (0.60, 'orange'),
    (0.80, 'red'),
    (1.0,  'darkred')
]
cmap_custom = LinearSegmentedColormap.from_list("black_blue_yellow_red", [c[1] for c in colors], N=256)

def create_fls_frequency_map(df, title, output_name, output_dir, max_display_freq=25.0, data_type=""):
    """Create a map showing FLS frequency at each station"""
    
    # Load Morocco borders
    try:
        morocco_borders = gpd.read_file('Morocco_ADM0_simplified.simplified.geojson')
    except Exception as e:
        print(f"Could not load Morocco borders: {e}")
        morocco_borders = None
    
    # Create figure and axis with cartopy projection
    fig = plt.figure(figsize=(16, 12))
    ax = plt.axes(projection=ccrs.PlateCarree())
    
    # Get station data
    station_summary = df.groupby('station').agg({
        'fls_frequency': 'mean',
        'latitude': 'first',
        'longitude': 'first'
    }).reset_index()
    
    # Create scatter plot with color based on FLS frequency (capped at max_display_freq)
    sc = ax.scatter(station_summary['longitude'], 
                   station_summary['latitude'], 
                   c=np.minimum(station_summary['fls_frequency'], max_display_freq),
                   cmap=cmap_custom, 
                   s=200, 
                   edgecolor='black', 
                   linewidth=1.5,
                   vmin=0, vmax=max_display_freq,
                   transform=ccrs.PlateCarree(),
                   zorder=5)
    
    # Add station labels
    for _, row in station_summary.iterrows():
        ax.annotate(f"{row['station']}\n({row['fls_frequency']:.1f}%)", 
                   (row['longitude'], row['latitude']),
                   xytext=(5, 5), 
                   textcoords='offset points',
                   fontsize=9,
                   fontweight='bold',
                   bbox=dict(boxstyle="round,pad=0.3", facecolor='white', alpha=0.8, edgecolor='gray'),
                   transform=ccrs.PlateCarree(),
                   zorder=6)
    
    # Add coastline in BLACK
    ax.add_feature(cfeature.COASTLINE, linewidth=1.2, edgecolor='black')
    
    # Add ocean
    ax.add_feature(cfeature.OCEAN, color='lightblue', alpha=0.3)
    
    # Add Morocco shapefile only
    if morocco_borders is not None:
        morocco_borders.plot(ax=ax, color='none', edgecolor='black', linewidth=1.2, transform=ccrs.PlateCarree())
    
    # Add colorbar
    cbar = plt.colorbar(sc, ax=ax, orientation="vertical", label="FLS Frequency (%)", shrink=0.8)
    cbar_ticks = np.arange(0, max_display_freq + 1, 5)
    cbar.set_ticks(cbar_ticks)
    cbar.set_ticklabels([f"{t:.0f}%" for t in cbar_ticks])
    
    # Set map limits for Morocco
    ax.set_extent([-20, -1, 20, 36], crs=ccrs.PlateCarree())
    
    # Add gridlines
    gl = ax.gridlines(draw_labels=True, dms=True, x_inline=False, y_inline=False, alpha=0.3)
    gl.top_labels = False
    gl.right_labels = False
    
    # Add title
    ax.set_title(title, fontsize=14, fontweight='bold', pad=20)
    
    # Add note about data type
    high_freq_stations = station_summary[station_summary['fls_frequency'] > max_display_freq]
    note_text = f"Data: {data_type}\n"
    if len(high_freq_stations) > 0:
        note_text += f"Note: Stations above {max_display_freq}% shown at maximum color intensity\n"
        note_text += "High frequency stations: " + ", ".join(high_freq_stations['station'].tolist())
    
    ax.text(0.02, 0.02, note_text, transform=ax.transAxes, fontsize=9,
           bbox=dict(boxstyle="round,pad=0.5", facecolor='lightblue', alpha=0.7))
    
    plt.tight_layout()
    plt.savefig(os.path.join(output_dir, output_name), dpi=300, bbox_inches="tight")
    plt.close()
    
    print(f"Map saved: {output_name}")
    return station_summary

def get_season(month):
    """Get season for a given month"""
    if month in [12, 1, 2]:
        return 'Winter'
    elif month in [3, 4, 5]:
        return 'Spring'
    elif month in [6, 7, 8]:
        return 'Summer'
    else:
        return 'Autumn'

def get_data_combination(complete_data, period, condition):
    """Get data for specific period and condition combination"""
    if period == 'jour' and condition == 'cf':
        return complete_data[(complete_data['condition_type'] == 'cf')].copy()
    elif period == 'jour' and condition == 'hc':
        return complete_data[(complete_data['condition_type'] == 'hc')].copy()
    elif period == 'nuit' and condition == 'cf':
        return complete_data[(complete_data['condition_type'] == 'cf')].copy()
    elif period == 'nuit' and condition == 'hc':
        return complete_data[(complete_data['condition_type'] == 'hc')].copy()

def get_data_description(period, condition):
    """Get description for data combination"""
    descriptions = {
        'jour_cf': "Jour (18h-6h) - Conditions faibles (cf)",
        'jour_hc': "Jour (18h-6h) - Conditions élevées (hc)", 
        'nuit_cf': "Nuit (6h-18h) - Conditions faibles (cf)",
        'nuit_hc': "Nuit (6h-18h) - Conditions élevées (hc)"
    }
    return descriptions.get(f"{period}_{condition}", "")

def create_all_combinations_maps(complete_data):
    """Create maps for all 4 combinations: jour_cf, jour_hc, nuit_cf, nuit_hc"""
    
    print("=" * 80)
    print("CREATING MAPS FOR ALL 4 COMBINATIONS")
    print("=" * 80)
    
    # Define seasons with correct months for 2024
    seasons = {
        'Winter': [12, 1, 2],    # Décembre 2024, Janvier 2024, Février 2024
        'Spring': [3, 4, 5],     # Mars, Avril, Mai 2024
        'Summer': [6, 7, 8],     # Juin, Juillet, Août 2024
        'Autumn': [9, 10, 11]    # Septembre, Octobre, Novembre 2024
    }
    
    results = {}
    
    # Process all 4 combinations
    combinations = [
        ('jour', 'cf'),
        ('jour', 'hc'), 
        ('nuit', 'cf'),
        ('nuit', 'hc')
    ]
    
    for period, condition in combinations:
        combo_name = f"{period}_{condition}"
        print(f"\n{'='*50}")
        print(f"PROCESSING: {combo_name.upper()}")
        print(f"{'='*50}")
        
        # Get data for this combination
        combo_data = get_data_combination(complete_data, period, condition)
        data_description = get_data_description(period, condition)
        
        print(f"Records: {len(combo_data)}")
        print(f"Description: {data_description}")
        print(f"Average FLS frequency: {combo_data['fls_frequency'].mean():.1f}%")
        
        output_dir = output_dirs[combo_name]
        
        # Annual map
        title_annual = f'FLS Frequency - Annual 2024 ({data_description})'
        output_annual = f"fls_annual_{combo_name}_2024.png"
        results[f'{combo_name}_annual'] = create_fls_frequency_map(
            combo_data, title_annual, output_annual, output_dir, 
            data_type=data_description
        )
        
        # Monthly maps
        months = sorted(combo_data['month'].unique())
        for month in months:
            month_name = datetime(2024, month, 1).strftime('%B')
            month_data = combo_data[combo_data['month'] == month]
            
            if len(month_data) > 0:
                title_month = f'FLS Frequency - {month_name} 2024 ({data_description})'
                output_month = f"fls_{month_name.lower()}_{combo_name}_2024.png"
                create_fls_frequency_map(
                    month_data, title_month, output_month, output_dir,
                    data_type=data_description
                )
        
        # Seasonal maps
        for season_name, season_months in seasons.items():
            season_data = combo_data[combo_data['month'].isin(season_months)]
            
            if len(season_data) > 0:
                title_season = f'FLS Frequency - {season_name} 2024 ({data_description})'
                output_season = f"fls_{season_name.lower()}_{combo_name}_2024.png"
                create_fls_frequency_map(
                    season_data, title_season, output_season, output_dir,
                    data_type=data_description
                )
    
    return results

def generate_comprehensive_statistics(complete_data):
    """Generate comprehensive statistics for all 4 combinations"""
    
    print("\n" + "=" * 80)
    print("COMPREHENSIVE STATISTICS FOR ALL 4 COMBINATIONS")
    print("=" * 80)
    
    # Calculate statistics for each combination
    combinations_stats = {}
    
    combinations = [
        ('jour', 'cf'),
        ('jour', 'hc'), 
        ('nuit', 'cf'),
        ('nuit', 'hc')
    ]
    
    print(f"\n{'COMBINATION':<20} {'RECORDS':<10} {'AVG FREQ':<12} {'TOTAL HOURS':<15} {'STATIONS':<10}")
    print("-" * 70)
    
    for period, condition in combinations:
        combo_name = f"{period}_{condition}"
        combo_data = get_data_combination(complete_data, period, condition)
        
        if len(combo_data) > 0:
            avg_freq = combo_data['fls_frequency'].mean()
            total_hours = combo_data['fls_hours'].sum()
            num_stations = combo_data['station'].nunique()
            num_records = len(combo_data)
            
            combinations_stats[combo_name] = {
                'avg_frequency': avg_freq,
                'total_hours': total_hours,
                'stations': num_stations,
                'records': num_records
            }
            
            print(f"{combo_name:<20} {num_records:<10} {avg_freq:<11.1f}% {total_hours:<14,} {num_stations:<10}")
    
    # Comparison analysis
    print(f"\nCOMPARISON ANALYSIS:")
    print("-" * 40)
    
    # Compare jour vs nuit for each condition type
    print(f"\nJour vs Nuit comparison:")
    for condition in ['cf', 'hc']:
        jour_data = get_data_combination(complete_data, 'jour', condition)
        nuit_data = get_data_combination(complete_data, 'nuit', condition)
        
        if len(jour_data) > 0 and len(nuit_data) > 0:
            jour_avg = jour_data['fls_frequency'].mean()
            nuit_avg = nuit_data['fls_frequency'].mean()
            diff = nuit_avg - jour_avg
            
            print(f"  {condition.upper()}: Jour {jour_avg:.1f}% vs Nuit {nuit_avg:.1f}% = {diff:+.1f}%")
    
    # Compare cf vs hc for each period
    print(f"\nCF vs HC comparison:")
    for period in ['jour', 'nuit']:
        cf_data = get_data_combination(complete_data, period, 'cf')
        hc_data = get_data_combination(complete_data, period, 'hc')
        
        if len(cf_data) > 0 and len(hc_data) > 0:
            cf_avg = cf_data['fls_frequency'].mean()
            hc_avg = hc_data['fls_frequency'].mean()
            diff = hc_avg - cf_avg
            
            print(f"  {period.capitalize()}: CF {cf_avg:.1f}% vs HC {hc_avg:.1f}% = {diff:+.1f}%")
    
    return combinations_stats

