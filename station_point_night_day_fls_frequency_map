def compare_day_night_fls(df):
    """Compare day vs night FLS frequencies"""
    
    # Separate day and night data
    day_data = df[df['condition_type'] == 'cf']
    night_data = df[df['condition_type'] == 'hc']
    
    # Calculate statistics
    day_summary = day_data.groupby('station').agg({
        'fls_frequency': 'mean',
        'fls_hours': 'sum'
    }).add_prefix('day_')
    
    night_summary = night_data.groupby('station').agg({
        'fls_frequency': 'mean', 
        'fls_hours': 'sum'
    }).add_prefix('night_')
    
    # Combine
    comparison = pd.concat([day_summary, night_summary], axis=1)
    comparison['difference'] = comparison['night_fls_frequency'] - comparison['day_fls_frequency']
    
    return comparison.sort_values('night_fls_frequency', ascending=False)

