    def plot_score_comparison(self, fog_type='cf'):
        """Score comparison between stations"""
        annual_data = self.results_df[
            (self.results_df['period'] == 'annual') & 
            (self.results_df['fog_type'] == fog_type)
        ].copy()
        
        if annual_data.empty:
            print(f"No annual data for {fog_type}")
            return
        
        # Select main scores
        scores_to_plot = ['POD', 'FAR', 'FBIAS', 'TS']
        
        fig, axes = plt.subplots(2, 2, figsize=(15, 12))
        axes = axes.flatten()
        
        for i, score in enumerate(scores_to_plot):
            ax = axes[i]
            station_data = annual_data[['station', score]].dropna()
            station_data = station_data.sort_values(score)
            
            bars = ax.barh(station_data['station'], station_data[score], 
                          color=plt.cm.viridis(np.linspace(0, 1, len(station_data))))
            
            ax.set_xlabel(score)
            ax.set_title(f'{score} by Station ({fog_type.upper()})')
            ax.grid(True, alpha=0.3, axis='x')
            
            # Add values on bars
            for bar in bars:
                width = bar.get_width()
                ax.text(width + 0.01, bar.get_y() + bar.get_height()/2, 
                       f'{width:.2f}', ha='left', va='center', fontsize=9)
        
        plt.tight_layout()
        filename = f'{OUTPUT_PATH}/score_comparison_{fog_type}.png'
        plt.savefig(filename, dpi=300, bbox_inches='tight')
        print(f"Score comparison saved: {filename}")
        plt.show()
    
