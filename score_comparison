        # Monthly average table
        monthly_data = self.results_df[self.results_df['period'] == 'monthly']
        summary_monthly = monthly_data.groupby(['month', 'fog_type']).agg({
            'POD': 'mean',
            'FAR': 'mean',
            'FBIAS': 'mean',
            'TS': 'mean',
            'HSS': 'mean',
            'n_obs': 'sum'
        }).round(3)
        
        # Global summary
        global_summary = annual_data.groupby('fog_type').agg({
            'POD': 'mean',
            'FAR': 'mean',
            'FBIAS': 'mean',
            'TS': 'mean',
            'HSS': 'mean',
            'n_obs': 'sum'
        }).round(3)
        
        # Save tables
        summary_annual.to_csv(f'{OUTPUT_PATH}/summary_annual.csv')
        summary_monthly.to_csv(f'{OUTPUT_PATH}/summary_monthly.csv')
        global_summary.to_csv(f'{OUTPUT_PATH}/summary_global.csv')
        
        print("Summary tables created successfully!")
        
        # Display global summary
        print("\n=== GLOBAL SUMMARY ===")
        print(global_summary)
        
        return summary_annual, summary_monthly, global_summary

def main():
    """Main function"""
    print("=== STARTING FLS ANALYSIS ===")
    
    # Create processor
    processor = FogDataProcessor()
    
    # List files
    satellite_files = list(Path(SATELLITE_PATH).glob('*fls_RGB.csv'))
    station_files = list(Path(STATION_PATH).glob('*fls_600*.xlsx'))
    
    print(f"Satellite files found: {len(satellite_files)}")
    print(f"Station files found: {len(station_files)}")
    
    all_results = []
    
    # Process only stations that have data in donnesfls
    stations_to_process = []
    
    # Identify stations available in donnesfls
    for station_file in station_files:
        station_name, month, fog_type = processor.parse_station_filename(station_file.name)
        if station_name and station_name not in stations_to_process:
            stations_to_process.append(station_name)
    
    print(f"\nStations to process ({len(stations_to_process)}): {stations_to_process}")
    
    # For each station in donnesfls, find corresponding satellite file
    for station_donnesfls in stations_to_process:
        print(f"\n=== Processing station: {station_donnesfls} ===")
        
        # Find corresponding name in flsparrgb
        satellite_station_name = None
        for sat_name, donnesfls_name in processor.station_mapping.items():
            if donnesfls_name == station_donnesfls:
                satellite_station_name = sat_name
                break
        
        if not satellite_station_name:
            print(f"  No satellite file match found for {station_donnesfls}")
            continue
        
        # Find satellite file
        satellite_file = None
        for sat_file in satellite_files:
            sat_station_from_file = processor.parse_satellite_station_name(sat_file.name)
            if sat_station_from_file == satellite_station_name:
                satellite_file = sat_file
                break
        
        if not satellite_file:
            print(f"  Satellite file not found for {satellite_station_name}")
            continue
        
        print(f"  Satellite file found: {satellite_file.name}")
        
        # Load satellite data once for the entire station
        satellite_df = processor.load_satellite_data(satellite_file)
        if satellite_df is None:
            continue
        
        # Find all station files for this station
        station_files_for_station = [
            f for f in station_files 
            if station_donnesfls in f.name
        ]
        
        print(f"  Station files found: {len(station_files_for_station)}")
        
        # Process for each constraint type
        for fog_type in ['cf', 'hc']:
            results = processor.process_station_month(
                station_donnesfls, satellite_df, station_files_for_station, fog_type
            )
            
            if results is not None and not results.empty:
                all_results.append(results)
                print(f"  ✓ Scores calculated for {station_donnesfls} ({fog_type})")
            else:
                print(f"  ✗ Failed to calculate scores for {station_donnesfls} ({fog_type})")
    
    # Combine all results
    if all_results:
        final_results = pd.concat(all_results, ignore_index=True)
        
        # Save complete results
        final_results.to_csv(f'{OUTPUT_PATH}/scores_fls_complete.csv', index=False)
        
        print(f"\n=== ANALYSIS COMPLETED SUCCESSFULLY ===")
        print(f"Stations processed: {final_results['station'].nunique()}")
        print(f"Fog types analyzed: {final_results['fog_type'].unique().tolist()}")
        print(f"Total scores calculated: {len(final_results)}")
        print(f"Results file: {OUTPUT_PATH}/scores_fls_complete.csv")
        
        return final_results
    else:
        print("\n=== NO RESULTS GENERATED ===")
        return None

