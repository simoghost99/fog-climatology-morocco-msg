class FogDataProcessor:
    def __init__(self):
        self.scores_df = pd.DataFrame()
        self.station_mapping = self._create_station_mapping()
        
    def _create_station_mapping(self):
        """Create mapping between station names in both directories"""
        mapping = {
            # Format: 'name_in_flsparrgb': 'name_in_donnesfls'
            'AGADIR AL MASSIRA': 'AGADIR-MASSIRA',
            'AL-HOUCEIMA': 'AL-HOCEIMA',
            'FES-SAISS': 'FES-SAIS',
            'KENITRA': 'KENITRA',
            'LAAYOUNE': 'LAAYOUNE',
            'MARRAKECH': 'MARRAKECH',
            'MEKNES': 'MEKNES',
            'NOUASSEUR': 'NOUASSEUR',
            'OUJDA': 'OUJDA',
            'RABAT-SALE': 'RABAT-SALE',
            'SIDI SLIMANE': 'SIDI-SLIMANE',
            'TANGER-AERO': 'TANGER-AERO',
            # Add TETOUAN even if not in flsparrgb
            'TETOUAN': 'TETOUAN'
        }
        return mapping
    
    def parse_satellite_station_name(self, filename):
        """Extract station name from satellite file"""
        # Remove extension and 'fls_RGB'
        name = filename.replace('fls_RGB.csv', '').replace('.csv', '').strip()
        return name
    
    def parse_station_filename(self, filename):
        """Extract station name and month from station file"""
        # Pattern to extract name and month
        pattern = r'([A-Z\-]+)-(\d{2})2024_fls_600(cf|hc)\.xlsx'
        match = re.match(pattern, filename)
        if match:
            station_name = match.group(1)
            month = int(match.group(2))
            fog_type = match.group(3)
            return station_name, month, fog_type
        return None, None, None
    
    def load_satellite_data(self, file_path):
        """Load satellite data"""
        try:
            print(f"Loading satellite data: {file_path.name}")
            df = pd.read_csv(file_path)
            df['datetime'] = pd.to_datetime(df['datetime'])
            df['date'] = df['datetime'].dt.date
            df['hour'] = df['datetime'].dt.hour
            df['month'] = df['datetime'].dt.month
            df['year'] = df['datetime'].dt.year
            print(f"  Satellite data loaded: {len(df)} rows")
            return df
        except Exception as e:
            print(f"Error loading satellite {file_path}: {e}")
            return None
    
    def load_station_data(self, file_path, fog_type='cf'):
        """Load station data with constraint type"""
        try:
            print(f"Loading station data: {file_path.name}")
            df = pd.read_excel(file_path)
            
            # Standardize column names
            df.columns = [col.lower().strip() for col in df.columns]
            
            # Check required columns
            required_cols = ['jour', 'hour']
            if not all(col in df.columns for col in required_cols):
                print(f"Missing columns in {file_path.name}. Available columns: {df.columns.tolist()}")
                return None
            
            # Find FLS column (may be called 'fls' or something else)
            fls_col = None
            for col in df.columns:
                if 'fls' in col.lower():
                    fls_col = col
                    break
            
            if fls_col is None:
                print(f"No FLS column found in {file_path.name}")
                return None
            
            # Convert date and time
            df['datetime'] = pd.to_datetime(df['jour'].astype(str) + 
                                          df['hour'].astype(str).str.zfill(2), 
                                          format='%Y%m%d%H')
            df['date'] = df['datetime'].dt.date
            df['hour'] = df['datetime'].dt.hour
            df['month'] = df['datetime'].dt.month
            df['year'] = df['datetime'].dt.year
            
            # Rename FLS column for standardization
            df.rename(columns={fls_col: 'fls'}, inplace=True)
            
            print(f"  Station data loaded: {len(df)} rows")
            return df
        except Exception as e:
            print(f"Error loading station {file_path}: {e}")
            return None
    
    def calculate_verification_scores(self, observed, forecast):
        """Calculate verification scores"""
        # Convert to boolean for FLS present/absent
        obs_bool = (observed > 0).astype(int)
        fc_bool = (forecast > 0).astype(int)
        
        # Contingency table
        a = ((fc_bool == 1) & (obs_bool == 1)).sum()  # Hits
        b = ((fc_bool == 1) & (obs_bool == 0)).sum()  # False alarms
        c = ((fc_bool == 0) & (obs_bool == 1)).sum()  # Misses
        d = ((fc_bool == 0) & (obs_bool == 0)).sum()  # Correct negatives
        
        # Calculate scores
        scores = {}
        
        # POD (Probability Of Detection)
        if (a + c) > 0:
            scores['POD'] = a / (a + c)
        else:
            scores['POD'] = np.nan
            
        # FAR (False Alarm Ratio)
        if (a + b) > 0:
            scores['FAR'] = b / (a + b)
        else:
            scores['FAR'] = np.nan
            
        # FBIAS (Frequency Bias)
        if (a + c) > 0:
            scores['FBIAS'] = (a + b) / (a + c)
        else:
            scores['FBIAS'] = np.nan
            
        # POFD (Probability Of False Detection)
        if (b + d) > 0:
            scores['POFD'] = b / (b + d)
        else:
            scores['POFD'] = np.nan
            
        # TS (Threat Score)
        if (a + b + c) > 0:
            scores['TS'] = a / (a + b + c)
        else:
            scores['TS'] = np.nan
            
        # HSS (Heidke Skill Score)
        denominator = ((a+c)*(c+d) + (a+b)*(b+d))
        if denominator > 0:
            scores['HSS'] = 2*(a*d - b*c) / denominator
        else:
            scores['HSS'] = np.nan
            
        # Accuracy
        if (a + b + c + d) > 0:
            scores['ACCURACY'] = (a + d) / (a + b + c + d)
        else:
            scores['ACCURACY'] = np.nan
            
        # Base rates
        total = a + b + c + d
        if total > 0:
            scores['OBS_RATE'] = (a + c) / total
            scores['FC_RATE'] = (a + b) / total
        else:
            scores['OBS_RATE'] = np.nan
            scores['FC_RATE'] = np.nan
        
        # Counts
        scores['HITS'] = a
        scores['FALSE_ALARMS'] = b
        scores['MISSES'] = c
        scores['CORRECT_NEGATIVES'] = d
        
        return scores
    
    def process_station_month(self, station_name, satellite_df, station_files, fog_type='cf'):
        """Process data for a specific station and month"""
        print(f"\n=== Processing station: {station_name} ({fog_type}) ===")
        
        all_monthly_results = []
        
        # Process each station file (each month)
        for station_file in station_files:
            station_name_from_file, month, file_fog_type = self.parse_station_filename(station_file.name)
            
            # Verify type matches
            if file_fog_type != fog_type:
                continue
                
            print(f"  Processing month {month:02d}/2024")
            
            # Load station data for this month
            stat_df = self.load_station_data(station_file, fog_type)
            if stat_df is None:
                continue
            
            # Filter satellite data for the same month
            sat_month_df = satellite_df[satellite_df['month'] == month].copy()
            if sat_month_df.empty:
                print(f"    No satellite data for month {month}")
                continue
            
            # Merge data on datetime
            merged_df = pd.merge(
                sat_month_df, 
                stat_df[['datetime', 'fls']], 
                on='datetime', 
                how='inner',
                suffixes=('_sat', '_stat')
            )
            
            if merged_df.empty:
                print(f"    No common data for month {month}")
                continue
            
            print(f"    Merged data: {len(merged_df)} common observations")
            
            # Calculate scores for this month
            monthly_scores = self.calculate_verification_scores(
                merged_df['fls_stat'], merged_df['fls_sat']
            )
            monthly_scores.update({
                'station': station_name,
                'period': 'monthly',
                'month': month,
                'year': 2024,
                'fog_type': fog_type,
                'n_obs': len(merged_df)
            })
            all_monthly_results.append(monthly_scores)
        
        # Calculate annual scores if we have data
        if all_monthly_results:
            # Combine all months to calculate annual scores
            all_station_data = []
            for station_file in station_files:
                station_name_from_file, month, file_fog_type = self.parse_station_filename(station_file.name)
                if file_fog_type == fog_type:
                    stat_df = self.load_station_data(station_file, fog_type)
                    if stat_df is not None:
                        sat_month_df = satellite_df[satellite_df['month'] == month].copy()
                        if not sat_month_df.empty:
                            merged_df = pd.merge(
                                sat_month_df, 
                                stat_df[['datetime', 'fls']], 
                                on='datetime', 
                                how='inner',
                                suffixes=('_sat', '_stat')
                            )
                            if not merged_df.empty:
                                all_station_data.append(merged_df)
            
            if all_station_data:
                annual_merged_df = pd.concat(all_station_data, ignore_index=True)
                annual_scores = self.calculate_verification_scores(
                    annual_merged_df['fls_stat'], annual_merged_df['fls_sat']
                )
                annual_scores.update({
                    'station': station_name,
                    'period': 'annual',
                    'month': 'all',
                    'year': 2024,
                    'fog_type': fog_type,
                    'n_obs': len(annual_merged_df)
                })
                all_monthly_results.append(annual_scores)
                
                print(f"  ✓ Scores calculated for {station_name} ({fog_type}) - {len(annual_merged_df)} annual observations")
            else:
                print(f"  ✗ No annual data for {station_name} ({fog_type})")
        
        return pd.DataFrame(all_monthly_results) if all_monthly_results else None

