        # Filter data
        data = self.results_df[
            (self.results_df['period'] == period) & 
            (self.results_df['fog_type'] == fog_type)
        ].copy()
        
        if data.empty:
            print(f"No data for {period}, {fog_type}")
            return
        
        # Prepare data for map
